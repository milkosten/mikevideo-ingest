# mikevideo-ingest configuration. Copy to .env and fill secrets (never commit .env).

# Port the container listens on (published on 172.17.0.1 for Caddy).
PORT=8080

# Where sessions live. On the box this is the big RAID at /data.
DATA_ROOT=/data/mikevideo/ingest

# P1 bootstrap static bearer token (use a long random value in production).
INGEST_TOKEN=change-me-to-a-long-random-token

# Shared HMAC secret for signed upload tickets (mikevideo-cloud mints them).
INGEST_HMAC_SECRET=change-me-to-a-long-random-secret

# Caps / guards.
MAX_TOTAL_SIZE=21474836480      # 20 GiB
MAX_CHUNK_SIZE=8388608          # 8 MiB
MAX_CONCURRENT_WRITES=8
SESSION_TTL_HOURS=48

# Control-plane completion callback (mikevideo-cloud). Leave blank for P1.
CALLBACK_URL=
CALLBACK_SECRET=
